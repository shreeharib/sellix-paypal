# Copy to .env for local development; never commit .env. Generate the secrets with:
#   uv run python -m app.cli generate-secrets
# Real values for dev/demo live in Render environment groups and the team password manager.

APP_ENV=local                      # local | dev | demo | prod
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000  # public https:// address (the tunnel URL locally)

# Database: direct or session-pooler connection, NOT the transaction pooler (port 6543),
# because the job queue uses LISTEN/NOTIFY.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/sellix
RUN_WORKER_IN_PROCESS=true

# Secrets
TOKEN_ENCRYPTION_KEYS=             # Fernet key(s), comma-separated; the first one encrypts
OAUTH_STATE_SECRET=
SESSION_SIGNING_KEY=               # signs the app's access tokens (32+ characters)
APP_REDIRECT_URIS=sellix://auth/callback,http://localhost:8080/auth.html  # where sign-in may return
WEB_APP_ORIGINS=http://localhost:8080  # browser origins allowed to call the API (the Flutter web app)

# Meta (Instagram API with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_APP_SECRET=                   # optional: the Meta app secret, also accepted for webhooks
META_VERIFY_TOKEN=                 # enter the same value in the Meta app's webhook settings
GRAPH_API_VERSION=v23.0
LOG_WEBHOOK_PAYLOADS=false         # true only in dev with test accounts (payloads hold DMs)

# LLM: any OpenAI-compatible chat completions API
LLM_BASE_URL=                      # e.g. https://<resource>.services.ai.azure.com/openai/v1
LLM_API_KEY=
LLM_MODEL=                         # model or deployment name
LLM_JSON_MODE=json_object          # json_object | none
LLM_REASONING_EFFORT=              # reasoning models only, e.g. low

# PayPal (developer.paypal.com > Apps & Credentials). Payment links are offered only when set.
PAYPAL_ENV=sandbox                 # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # from the webhook registered for /webhooks/paypal
PAYMENT_HOLD_MINUTES=15            # unpaid orders release their stock after this

# Agent turns
TURN_BATCH_SECONDS=3
HISTORY_MESSAGES=20
OWNER_FOLLOW_UP_MINUTES=30        # a customer waiting on the shop gets one "still checking" message
